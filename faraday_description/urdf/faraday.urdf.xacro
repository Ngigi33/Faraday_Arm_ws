<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="faraday_arm">

    <xacro:property name="PI" value="3.1415926535897932384626433832795"/>

    <!-- 
    ................................................................................................................. -->


    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/base.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- 
    ................................................................................................................. -->


    <link name="base_plate">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="base_plate"/>
        <origin xyz="0.0 0.0 2.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>
    <!-- 
    ................................................................................................................. -->
    <link name="jaw_2">
        <visual>
            <origin xyz="${PI/2} -0.4 0.2" rpy="0 0 -2.5"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw 2.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_2" type="revolute">
        <parent link="base_plate"/>
        <child link="jaw_2"/>
        <origin xyz="0.0 0.0 2.0" rpy="${PI/2} 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>

    <!-- 
    ................................................................................................................. -->
    <link name="jaw_3">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="-${PI/2} 0.0 0.0"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw3.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="jaw_2"/>
        <child link="jaw_3"/>
        <origin xyz="3.8 2.122385 -0.291650" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>

    <!-- 
    ................................................................................................................. -->

    <link name="jaw_4">
        <visual>
            <origin xyz="2.979 0.0 0.0" rpy="-${PI/2} 0.0 0.0"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw4.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_4" type="revolute">
        <parent link="jaw_3"/>
        <child link="jaw_4"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>

    <!-- 
    ................................................................................................................. -->

    <link name="jaw_5">
        <visual>
            <origin xyz="4.716 0.0 0.0" rpy="0.0 ${PI/2} ${PI/2}"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw5.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_5" type="revolute">
        <parent link="jaw_4"/>
        <child link="jaw_5"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>

    <!-- 
    ................................................................................................................. -->
    <link name="jaw_6">
        <visual>
            <origin xyz="5.25 0.0 0.0" rpy="0.0 ${PI/2} -${PI/2}"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaw6.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_6" type="revolute">
        <parent link="jaw_5"/>
        <child link="jaw_6"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>
    </joint>

    <!-- 
    ................................................................................................................. -->
    <link name="jaw_7">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://faraday_description/meshes/jaws7.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_7" type="revolute">
        <parent link="jaw_6"/>
        <child link="jaw_7"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 0.0"/>
        <limit lower="-${PI/2}" upper="${PI/2}" effort="10" velocity="1"/>

    </joint>



</robot>